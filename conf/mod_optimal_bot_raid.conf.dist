[worldserver]
#
# Optimal Bot Raid Configuration
#
# ==============================================================================
# LEVEL CAP
# ==============================================================================
# OptimalBotRaid.MaxLevelAbovePlayer
#    Description: Highest bot level a player may draft, relative to their own level,
#                 and never past the end of their 60/70/80 bracket.
#                 Custom ranges (.botraid assemble 60-67 40) are clamped to it.
#                 GMs are exempt.
#    Range:       0 to 80
#    Default:     2
OptimalBotRaid.MaxLevelAbovePlayer = 2

# OptimalBotRaid.SameLevelAtCaps
#    Description: At level 60, 70 and 80 players only draft bots of exactly their
#                 level (no lower-level fill-ins). The cap above also never reaches
#                 past the player's bracket (a level 59 can't draft level 61 bots).
#                 GMs are exempt.
#    Default:     1 - (Enabled)
#                 0 - (Disabled)
OptimalBotRaid.SameLevelAtCaps = 1

# ==============================================================================
# ALGORITHM HEURISTIC WEIGHTS
# ==============================================================================
# The bot drafting algorithm calculates a "Final Score" for every bot based on 
# their normalized GearScore (scaled against the highest geared bot in the pool) 
# and their Synergy Score (what unique WotLK buffs they bring to the group).
# 
# OptimalBotRaid.Algo.Weight.GS
#    Description: The mathematical weight applied to the bot's normalized gear score.
#    Range:       0.0 to 10.0
#    Default:     0.5
OptimalBotRaid.Algo.Weight.GS = 0.5

# OptimalBotRaid.Algo.Weight.Buff
#    Description: The mathematical weight applied to the bot's buff synergy score.
#    Range:       0.0 to 10.0
#    Default:     0.5
OptimalBotRaid.Algo.Weight.Buff = 0.5

# ==============================================================================
# SYNERGY BUFF SCORING
# ==============================================================================
# Evaluates WotLK buff overlap via a bitwise matrix. If a bot brings a WotLK 
# buff the raid DOES NOT currently have, they are awarded these points.
#
# Range for all Bonus Values: 0.0 to 10.0
#
# OptimalBotRaid.Algo.Bonus.UniqueBuff    (Base addition per unique WotLK buff. Default: 0.2)
# OptimalBotRaid.Algo.Bonus.Bloodlust     (Overriding massive bonus for BL/Heroism. Default: 0.4)
# OptimalBotRaid.Algo.Bonus.Replenishment (Overriding bonus for mana regeneration. Default: 0.2)
OptimalBotRaid.Algo.Bonus.UniqueBuff = 0.2
OptimalBotRaid.Algo.Bonus.Bloodlust = 0.4
OptimalBotRaid.Algo.Bonus.Replenishment = 0.2

# ==============================================================================
# TARGET ROLE QUOTAS BY RAID SIZE
# ==============================================================================
# The algorithm strictly enforces these quotas to ensure boss survivability, 
# deliberately prioritizing ranged DPS over melee to prevent cleave-mechanic wipes.
# Ranged DPS slots are automatically computed from the remaining raid capacity.
# If configured improperly (e.g. 10 tanks in a 5 man), the module mathematically clamps them.
# Range for all values: 0 to [Raid Size]

# 5-Man Dungeons
OptimalBotRaid.Quota.5.Tanks = 1
OptimalBotRaid.Quota.5.Healers = 1
OptimalBotRaid.Quota.5.MeleeMax = 1

# 10-Man Raids
OptimalBotRaid.Quota.10.Tanks = 2
OptimalBotRaid.Quota.10.Healers = 2
OptimalBotRaid.Quota.10.MeleeMax = 2

# 15-Man Scenarios/BGs
OptimalBotRaid.Quota.15.Tanks = 2
OptimalBotRaid.Quota.15.Healers = 3
OptimalBotRaid.Quota.15.MeleeMax = 3

# 20-Man Raids
OptimalBotRaid.Quota.20.Tanks = 2
OptimalBotRaid.Quota.20.Healers = 4
OptimalBotRaid.Quota.20.MeleeMax = 5

# 25-Man Raids
OptimalBotRaid.Quota.25.Tanks = 2
OptimalBotRaid.Quota.25.Healers = 5
OptimalBotRaid.Quota.25.MeleeMax = 6

# 40-Man Vanilla Raids (Average Raid Level <= 60)
OptimalBotRaid.Quota.40Vanilla.Tanks = 4
OptimalBotRaid.Quota.40Vanilla.Healers = 10
OptimalBotRaid.Quota.40Vanilla.MeleeMax = 10

# 40-Man WotLK Raids (Average Raid Level > 60)
OptimalBotRaid.Quota.40WotLK.Tanks = 3
OptimalBotRaid.Quota.40WotLK.Healers = 8
OptimalBotRaid.Quota.40WotLK.MeleeMax = 10

# ==============================================================================
# RAID LINEUPS
# ==============================================================================
# Used instead of the quotas above when the leader assembles inside that raid, or
# anywhere with ".botraid assemble <raid> [size]" (".botraid raids" lists them).
# Sizes without a lineup fall back to the quotas above; a raid with one size
# doesn't need the size. Ranged slots are whatever is left after tanks, healers
# and melee. Defaults come from raid guides, then shifted toward ranged and an
# extra healer where bots struggle (see the README for sources).

# --- Vanilla ---

# ZUL'GURUB (.botraid assemble zg)
#    Hakkar mind-controls tanks and Thekal splits three ways; Venoxis and Arlokk punish melee.
#    Default 20: 3 tanks, 6 healers, 3 melee, 8 ranged
OptimalBotRaid.Quota.ZulGurub.20.Tanks = 3
OptimalBotRaid.Quota.ZulGurub.20.Healers = 6
OptimalBotRaid.Quota.ZulGurub.20.MeleeMax = 3

# RUINS OF AHN'QIRAJ (.botraid assemble aq20)
#    Extra tank for Kurinnaxx swaps and Rajaxx waves; Moam, Ayamiss and Ossirian favor ranged.
#    Default 20: 3 tanks, 5 healers, 3 melee, 9 ranged
OptimalBotRaid.Quota.RuinsOfAhnQiraj.20.Tanks = 3
OptimalBotRaid.Quota.RuinsOfAhnQiraj.20.Healers = 5
OptimalBotRaid.Quota.RuinsOfAhnQiraj.20.MeleeMax = 3

# ONYXIA (.botraid assemble onyxia <10|25|40>)
#    Only ranged can hit her in the air.
#    Default 10: 2 tanks, 2 healers, 1 melee, 5 ranged
#    Default 25: 3 tanks, 5 healers, 3 melee, 14 ranged
#    Default 40: 4 tanks, 10 healers, 4 melee, 22 ranged
OptimalBotRaid.Quota.Onyxia.10.Tanks = 2
OptimalBotRaid.Quota.Onyxia.10.Healers = 2
OptimalBotRaid.Quota.Onyxia.10.MeleeMax = 1
OptimalBotRaid.Quota.Onyxia.25.Tanks = 3
OptimalBotRaid.Quota.Onyxia.25.Healers = 5
OptimalBotRaid.Quota.Onyxia.25.MeleeMax = 3
OptimalBotRaid.Quota.Onyxia.40.Tanks = 4
OptimalBotRaid.Quota.Onyxia.40.Healers = 10
OptimalBotRaid.Quota.Onyxia.40.MeleeMax = 4

# MOLTEN CORE (.botraid assemble mc)
#    Extra tanks for Garr, Golemagg and Majordomo; Ragnaros knocks melee into the lava.
#    Default 40: 5 tanks, 11 healers, 8 melee, 16 ranged
OptimalBotRaid.Quota.MoltenCore.40.Tanks = 5
OptimalBotRaid.Quota.MoltenCore.40.Healers = 11
OptimalBotRaid.Quota.MoltenCore.40.MeleeMax = 8

# BLACKWING LAIR (.botraid assemble bwl)
#    Five tanks for Vaelastrasz and the drakes; Vael and Nefarian need heavy healing.
#    Default 40: 5 tanks, 13 healers, 7 melee, 15 ranged
OptimalBotRaid.Quota.BlackwingLair.40.Tanks = 5
OptimalBotRaid.Quota.BlackwingLair.40.Healers = 13
OptimalBotRaid.Quota.BlackwingLair.40.MeleeMax = 7

# TEMPLE OF AHN'QIRAJ (.botraid assemble aq40)
#    Tanks for the Bug Trio, Sartura and Fankriss adds; Ouro and Huhuran punish melee.
