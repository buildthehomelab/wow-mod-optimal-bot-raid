OptimalBotRaid.Quota.TempleOfAhnQiraj.40.Tanks = 5
OptimalBotRaid.Quota.TempleOfAhnQiraj.40.Healers = 12
OptimalBotRaid.Quota.TempleOfAhnQiraj.40.MeleeMax = 7

# NAXXRAMAS (.botraid assemble naxx <10|25|40>)
#    Extra tanks for Patchwerk, Thaddius and the Horsemen; Heigan and Sapphiron favor ranged.
