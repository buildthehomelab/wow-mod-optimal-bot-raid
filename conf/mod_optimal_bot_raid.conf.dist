OptimalBotRaid.Quota.Naxxramas.10.Tanks = 2
OptimalBotRaid.Quota.Naxxramas.10.Healers = 2
OptimalBotRaid.Quota.Naxxramas.10.MeleeMax = 2
OptimalBotRaid.Quota.Naxxramas.25.Tanks = 3
OptimalBotRaid.Quota.Naxxramas.25.Healers = 5
OptimalBotRaid.Quota.Naxxramas.25.MeleeMax = 5
OptimalBotRaid.Quota.Naxxramas.40.Tanks = 6
OptimalBotRaid.Quota.Naxxramas.40.Healers = 12
OptimalBotRaid.Quota.Naxxramas.40.MeleeMax = 6

